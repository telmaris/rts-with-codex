# DECISIONS — social and organizational policies. One active decision at a time.

# -----------------------------------------------------------------------------
# PRODUCTION: timber and workshops
# -----------------------------------------------------------------------------
technology organized_timber_gathering
    name "Organized Timber Gathering"
    description "Households clear one marked tract at a time, sharing the heaviest work and leaving usable paths behind."
    category PRODUCTION
    layout_lane "Production"
    layout_order 500
    tags production
    research_time 120
    modifier ProductionCycleTime multiplier 0.909091 building Woodcutter
end

technology rotating_forest_crews
    name "Rotating Forest Crews"
    description "Smaller crews rotate through the woods; fewer hands are tied to each camp, though handovers cost a little time."
    category PRODUCTION
    layout_lane "Production"
    layout_order 2300
    tags production manpower
    research_time 150
    requires organized_timber_gathering
    modifier WorkerCapacity additive -1 building Woodcutter
    modifier ProductionCycleTime multiplier 1.111111 building Woodcutter
end

technology sawmill_discipline
    name "Sawmill Discipline"
    description "Logs arrive sorted, blades are tended between shifts, and no crew waits for the last cart to clear the yard."
    category PRODUCTION
    layout_lane "Production"
    layout_order 3300
    tags production
    research_time 180
    requires rotating_forest_crews
    modifier ProductionCycleTime multiplier 0.833333 building LumberMill
end

technology standardized_timber_sizes
    name "Standardized Timber Sizes"
    description "Common beam lengths and measured planks speed up construction, but sorting them makes the mill more labor-hungry."
    category PRODUCTION
    layout_lane "Production"
    layout_order 4300
    tags production construction
    research_time 210
    requires sawmill_discipline
    modifier BuildTime multiplier 0.909091
    modifier WorkerCapacity additive 1 building LumberMill
end

technology master_builders_guild
    name "Master Builders' Guild"
    description "Master builders coordinate several works at once, but insist that every site use proper tools and paid specialists."
    category PRODUCTION
    layout_lane "Production"
    layout_order 5300
    tags construction production
    research_time 270
    requires standardized_timber_sizes
    modifier BuilderAmount additive 1
    modifier BuildCost multiplier 1.10
    modifier PopulationCap additive 20 building Village
end

# PRODUCTION: roads and haulage
technology village_path_wardens
    name "Village Path Wardens"
    description "Wardens keep ruts filled, brush cut back, and crossings passable between the settlements."
    category PRODUCTION
    layout_lane "Production"
    layout_order 2500
    tags logistics
    research_time 120
    requires organized_timber_gathering
    modifier RoadSpeed multiplier 1.10 building Road
end

technology scheduled_cart_convoys
    name "Scheduled Cart Convoys"
    description "Carts leave together and waste less road space, at the cost of waiting for the appointed bell."
    category PRODUCTION
    layout_lane "Production"
    layout_order 3500
    tags logistics
    research_time 150
    requires village_path_wardens
    modifier RoadCapacity additive 2 building Road
    modifier TransportTime multiplier 1.111111
end

technology milestone_posts
    name "Milestone Posts"
    description "Marked distances and known waypoints turn uncertain journeys into repeatable routes."
    category PRODUCTION
    layout_lane "Production"
    layout_order 4500
    tags logistics
    research_time 180
    requires scheduled_cart_convoys
    modifier TransportTime multiplier 0.833333
end

technology roadwork_levies
    name "Roadwork Levies"
    description "Every household owes days of labor to the roads, taking strong backs away from ordinary village life."
    category PRODUCTION
    layout_lane "Production"
    layout_order 5500
    tags logistics manpower construction
    research_time 210
    requires milestone_posts
    modifier BuildTime multiplier 0.833333 building Road
    modifier ManpowerRate multiplier 0.90
end

technology royal_road_charter
    name "Royal Road Charter"
    description "The main roads are widened, surveyed, and maintained as works of state rather than local paths."
    category PRODUCTION
    layout_lane "Production"
    layout_order 6500
    tags logistics construction
    research_time 300
    requires roadwork_levies
    modifier RoadSpeed multiplier 1.20 building Road
    modifier RoadCapacity additive 3 building Road
    modifier BuildCost multiplier 1.10 building Road
    modifier ManpowerRate multiplier 1.10
end

# PRODUCTION: extraction and industry
technology shared_mining_claims
    name "Shared Mining Claims"
    description "Families stop guarding scattered pits and work a common face with shared timber, tools, and risk."
    category PRODUCTION
    layout_lane "Production"
    layout_order 2700
    tags production
    research_time 120
    requires organized_timber_gathering
    modifier ProductionOutputAmount category Ore multiplier 1.10
    modifier ProductionOutputAmount category Mineral multiplier 1.10
end

technology furnace_rebuilding_program
    name "Furnace Rebuilding Program"
    description "Old hearths are torn out before their replacements are ready; the disruption is deliberate and painful."
    category PRODUCTION
    layout_lane "Production"
    layout_order 3700
    tags production construction
    research_time 180
    requires shared_mining_claims
    modifier ProductionCycleTime multiplier 1.17647 building Foundry
end

technology practical_surveyors
    name "Practical Surveyors"
    description "Surveyors compare slopes, seams, weights, and distances until useful measurement becomes a public craft."
    category PRODUCTION
    layout_lane "Production"
    layout_order 4700
    tags production construction
    research_time 180
    requires furnace_rebuilding_program
    modifier ProductionCycleTime multiplier 0.909091 building Mine
end

technology continuous_furnace_watch
    name "Continuous Furnace Watch"
    description "Three watches keep the rebuilt furnace hot without pause; output rises, but the fire consumes another worker."
    category PRODUCTION
    layout_lane "Production"
    layout_order 5700
    tags production manpower
    research_time 240
    requires practical_surveyors
    modifier ProductionCycleTime multiplier 0.769231 building Foundry
    modifier WorkerCapacity additive 2 building Foundry
end

technology crown_manufactories
    name "Crown Manufactories"
    description "The crown concentrates contracts, standards, and oversight in privileged manufactories built for volume rather than thrift."
    category PRODUCTION
    layout_lane "Production"
    layout_order 6700
    tags production construction
    research_time 300
    requires continuous_furnace_watch
    modifier ProductionCycleTime multiplier 0.833333 building UrbanWorkshop
    modifier ProductionOutputAmount category CraftedGood multiplier 1.20
    modifier WorkerCapacity multiplier 1.10
    modifier BuildCost multiplier 1.10
    modifier PopulationCap additive 20 building Village
end

# -----------------------------------------------------------------------------
# WARFARE: muster and discipline
# -----------------------------------------------------------------------------
technology muster_rolls
    name "Muster Rolls"
    description "Every household records who can bear arms, what they own, and how quickly they can reach the muster."
    category WARFARE
    layout_lane "Warfare"
    layout_order 500
    tags military manpower
    research_time 120
    modifier UnitRecruitTime multiplier 0.909091
end

technology drill_on_the_commons
    name "Drill on the Commons"
    description "Repeated formation drill makes the levy steadier in a fight, if less willing to scatter and run ahead."
    category WARFARE
    layout_lane "Warfare"
    layout_order 2300
    tags military
    research_time 150
    requires muster_rolls
    modifier UnitAttackSpeed multiplier 1.10 unit militia
    modifier UnitMoveSpeed multiplier 0.90 unit militia
end

technology retained_sergeants
    name "Retained Sergeants"
    description "Veterans are removed from ordinary work and paid to turn seasonal levies into dependable companies."
    category WARFARE
    layout_lane "Warfare"
    layout_order 3300
    tags military manpower
    research_time 180
    requires drill_on_the_commons
    modifier UnitHp multiplier 1.10
    modifier ManpowerRate multiplier 0.90
    modifier PopulationCap additive 10 building Village
end

technology household_arms_inspection
    name "Household Arms Inspection"
    description "Only properly equipped households pass inspection; the host is stronger, but fewer people qualify for service."
    category WARFARE
    layout_lane "Warfare"
    layout_order 4300
    tags military manpower
    research_time 210
    requires retained_sergeants
    modifier UnitRoadAttack multiplier 1.10
    modifier UnitRecruitManpowerCost multiplier 1.10
    modifier ProductionCycleTime multiplier 0.909091 building Armorer
    modifier ProductionOutputAmount category Armor multiplier 1.10
end

technology professional_retinue
    name "Professional Retinue"
    description "A permanent retinue trades the cheapest levy for soldiers who expect long training, good weapons, and regular provision."
    category WARFARE
    layout_lane "Warfare"
    layout_order 5300
    tags military manpower
    research_time 300
    requires household_arms_inspection
    modifier UnitRoadAttack multiplier 1.10 unit swordsman
    modifier UnitHp multiplier 1.10 unit swordsman
    modifier UnitRecruitTime multiplier 1.10 unit swordsman
end

# WARFARE: watch and fortification
technology night_watch_rotations
    name "Night Watch Rotations"
    description "The watch is divided into fixed rotations so a rested crew always stands by the bow rack."
    category WARFARE
    layout_lane "Warfare"
    layout_order 2500
    tags military
    research_time 120
    requires muster_rolls
    modifier TowerAttackSpeed multiplier 1.10
    modifier HqDefense additive 1
end

technology fletchers_quota
    name "Fletchers' Quota"
    description "Each workshop owes a quota of straight shafts and matched heads, and each tower gains a specialist to judge them."
    category WARFARE
    layout_lane "Warfare"
    layout_order 3500
    tags military production
    research_time 150
    requires night_watch_rotations
    modifier TowerDamage multiplier 1.10
    modifier ProductionCycleTime multiplier 0.833333 building Bowyer
    modifier ProductionCycleTime multiplier 0.833333 building Fletchery
end

technology measured_kill_zones
    name "Measured Kill Zones"
    description "Range stakes and rehearsed arcs reward deliberate shots over hurried volleys."
    category WARFARE
    layout_lane "Warfare"
    layout_order 4500
    tags military
    research_time 180
    requires fletchers_quota
    modifier TowerRange multiplier 1.10
    modifier TowerAttackSpeed multiplier 0.90
end

technology dismantle_the_timber_ring
    name "Dismantle the Timber Ring"
    description "The old palisade is pulled down before its stone replacement is ready, leaving the heart of the realm exposed."
    category WARFARE
    layout_lane "Warfare"
    layout_order 5500
    tags military construction
    research_time 210
    requires measured_kill_zones
    modifier HqMaxHp multiplier 0.80
end

technology layered_stone_defenses
    name "Layered Stone Defenses"
    description "Ditch, wall, gatehouse, and elevated fire are designed as one defensive system rather than separate obstacles."
    category WARFARE
    layout_lane "Warfare"
    layout_order 6500
    tags military construction
    research_time 300
    requires dismantle_the_timber_ring
    modifier HqMaxHp multiplier 1.30
    modifier HqDefense additive 2
    modifier TowerRange multiplier 1.10
    modifier BuildCost multiplier 1.10 building DefenseTower
end

# WARFARE: campaign and siege
technology war_provisioning
    name "War Provisioning"
    description "Food and replacements are gathered before the summons, easing mobilization while burdening village reserves."
    category WARFARE
    layout_lane "Warfare"
    layout_order 2700
    tags military manpower
    research_time 120
    requires muster_rolls
    modifier UnitRecruitTime multiplier 0.909091
    modifier ManpowerRate multiplier 0.90
end

technology engineers_of_the_host
    name "Engineers of the Host"
    description "Carpenters and miners march with the host, building slow machines that turn timber into a weapon against walls."
    category WARFARE
    layout_lane "Warfare"
    layout_order 3700
    tags military construction
    research_time 180
    requires war_provisioning
    modifier UnitSiegeAttack multiplier 1.10 unit ram
    modifier UnitMoveSpeed multiplier 0.90 unit ram
    modifier ProductionCycleTime multiplier 0.833333 building SiegeWorkshop
end

technology officers_school
    name "Officers' School"
    description "Commanders learn maps, accounts, geometry, and the written order—skills that soon outgrow the needs of war."
    category WARFARE
    layout_lane "Warfare"
    layout_order 4700
    tags military construction
    research_time 180
    requires engineers_of_the_host
    modifier UnitMoveSpeed multiplier 1.10
    modifier BuilderAmount additive 1
    modifier ProductionCycleTime multiplier 0.909091 building Armorer
end

technology forced_march_doctrine
    name "Forced March Doctrine"
    description "The army reaches the decisive road first, accepting exhaustion and stragglers as the price of tempo."
    category WARFARE
    layout_lane "Warfare"
    layout_order 5700
    tags military
    research_time 240
    requires officers_school
    modifier UnitMoveSpeed multiplier 1.10
    modifier UnitHp multiplier 0.90
end

technology siege_ordinance
    name "Siege Ordinance"
    description "Every assault follows a written order of engineers, guards, stores, and claims, making conquest richer but preparation slower."
    category WARFARE
    layout_lane "Warfare"
    layout_order 6700
    tags military expansion
    research_time 300
    requires forced_march_doctrine
    modifier UnitSiegeAttack multiplier 1.20
    modifier ConquestSpoilsFraction additive 0.10
    modifier UnitRecruitTime multiplier 1.10
    modifier ProductionCycleTime multiplier 0.769231 building SiegeWorkshop
end

# -----------------------------------------------------------------------------
# SOCIAL: population and public labor
# -----------------------------------------------------------------------------
technology common_granary_rules
    name "Common Granary Rules"
    description "Food is issued on fixed days and measured by household; waste falls because provisions are packed in a predictable rhythm."
    category SOCIAL
    layout_lane "Social"
    layout_order 500
    tags manpower production
    research_time 120
    modifier ProductionCycleTime multiplier 0.909091 building Inn
    modifier ManpowerRate multiplier 1.10
end

technology census_of_hearths
    name "Census of Hearths and Herds"
    description "The council counts fires, dependants, empty beds, and breeding stock, turning rumor about the settlement into an administrative fact."
    category SOCIAL
    layout_lane "Social"
    layout_order 2300
    tags manpower
    research_time 150
    requires common_granary_rules
    modifier ManpowerRate multiplier 1.10
    modifier PopulationCap additive 20 building Village
    modifier ProductionOutputAmount category Livestock multiplier 1.10
end

technology emergency_labor_levy
    name "Emergency Labor Levy"
    description "One more construction gang is raised immediately by pulling able hands from farms, workshops, and new households."
    category SOCIAL
    layout_lane "Social"
    layout_order 3300
    tags manpower construction
    research_time 180
    requires census_of_hearths
    modifier BuilderAmount additive 1
    modifier ManpowerRate multiplier 0.90
end

technology permanent_works_corps
    name "Permanent Works Corps"
    description "The improvised levy becomes a trained corps with permanent tools and recruits of its own."
    category SOCIAL
    layout_lane "Social"
    layout_order 4300
    tags manpower construction
    research_time 240
    requires emergency_labor_levy
    modifier BuildTime multiplier 0.909091
    modifier ManpowerRate multiplier 1.10
    modifier PopulationCap additive 20 building Village
end

technology civic_obligations
    name "Civic Obligations"
    description "Roads, stores, and defenses become duties of citizenship; the state gains capacity, but every institution demands attendants."
    category SOCIAL
    layout_lane "Social"
    layout_order 5300
    tags manpower construction
    research_time 300
    requires permanent_works_corps
    modifier BuilderAmount additive 1
    modifier ProductionCycleTime multiplier 0.909091 building Inn
    modifier WorkerCapacity multiplier 1.10
    modifier PopulationCap additive 20 building Village
end
# SOCIAL: learning and patronage
technology traveling_scribes
    name "Traveling Scribes"
    description "Scribes move between settlements, copying accounts and teaching useful hands to read standard marks."
    category SOCIAL
    layout_lane "Social"
    layout_order 2500
    tags production manpower
    research_time 120
    requires common_granary_rules
    modifier ProductionCycleTime multiplier 0.909091 building Paperworks
    modifier ProductionCycleTime multiplier 0.833333 building Inkworks
end

technology academic_patronage
    name "Academic Patronage"
    description "A permanent stipend gives scholars a room, instruments, and the freedom to pursue questions without an immediate buyer."
    category SOCIAL
    layout_lane "Social"
    layout_order 4500
    tags production construction
    research_time 150
    requires apprenticeship_custom
    modifier ProductionCycleTime multiplier 0.952381 building University
end

technology apprenticeship_custom
    name "Apprenticeship Custom"
    description "Masters must train successors, spreading tacit skill beyond a single household or workshop."
    category SOCIAL
    layout_lane "Social"
    layout_order 3500
    tags production manpower
    research_time 180
    requires traveling_scribes
    modifier WorkerCapacity additive -1 building Smith
    modifier WorkerCapacity additive -1 building Paperworks
    modifier WorkerCapacity additive -1 building Tannery
    modifier WorkerCapacity additive -1 building Tailor
    modifier WorkerCapacity additive -1 building Weaver
end

technology public_lectures
    name "Public Lectures"
    description "Experiments are repeated before an audience; scrutiny improves knowledge, while every demonstration requires more assistants."
    category SOCIAL
    layout_lane "Social"
    layout_order 5500
    tags production manpower
    research_time 240
    requires academic_patronage
    modifier ProductionCycleTime multiplier 0.909091 building University
    modifier WorkerCapacity additive 2 building University
end

technology learned_societies
    name "Learned Societies"
    description "Correspondence, minutes, and repeatable demonstrations turn isolated discoveries into a cumulative enterprise."
    category SOCIAL
    layout_lane "Social"
    layout_order 6500
    tags production
    research_time 300
    requires public_lectures
    modifier ProductionCycleTime multiplier 0.833333 building University
    modifier ProductionCycleTime multiplier 0.909091 building Paperworks
    modifier ProductionCycleTime multiplier 0.909091 building Scriptorium
end

# SOCIAL: governance and exchange
technology council_of_elders
    name "Council of Elders"
    description "No major work begins without counsel; decisions are slower, but the settlement avoids its most dangerous mistakes."
    category SOCIAL
    layout_lane "Social"
    layout_order 2700
    tags construction military
    research_time 120
    requires common_granary_rules
    modifier HqDefense additive 1
    modifier BuildTime multiplier 1.111111
end

technology market_days
    name "Market Days"
    description "Regular market days synchronize carts, meals, news, and exchange across the settlement."
