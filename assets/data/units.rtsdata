# Unit definitions. Pilot balance values (ETAP 9) covering the plan's
# suggested archetypes: militia (cheap/weak), swordsman (melee core),
# knight (slow/armored), ram (siege specialist — high siege_attack, weak
# road_attack, so it needs an escort to survive the march). Not tuned by
# playtesting yet.
unit militia
    name "Militia"
    texture_id 0
    max_hp 26
    road_attack 3
    siege_attack 1
    armor 0
    move_speed 1.0
    attack_speed 1.0
    recruit_building Barracks
    recruit_time 8
    manpower_cost 5
    cost FOOD_PROVISIONS 3
end

unit swordsman
    name "Swordsman"
    texture_id 0
    max_hp 45
    road_attack 6
    siege_attack 2
    armor 2
    move_speed 0.9
    attack_speed 1.0
    recruit_building Barracks
    recruit_time 14
    manpower_cost 8
    cost IRON_SWORD 1
    cost FOOD_PROVISIONS 3
end

unit knight
    name "Knight"
    texture_id 0
    max_hp 75
    road_attack 8
    siege_attack 3
    armor 5
    move_speed 0.7
    attack_speed 0.9
    recruit_building Barracks
    recruit_time 22
    manpower_cost 12
    cost STEEL_SWORD 1
    cost FOOD_PROVISIONS 5
end

unit ram
    name "Battering Ram"
    texture_id 0
    max_hp 60
    road_attack 2
    siege_attack 12
    armor 3
    move_speed 0.6
    attack_speed 0.5
    recruit_building Barracks
    recruit_time 26
    manpower_cost 10
    cost PLANKS 20
    cost IRON 10
    cost FOOD_PROVISIONS 4
end
