    layout_order 500
    research_time 90
    cost PAPER 150
    modifier ProductionCycleTime multiplier 0.95
    modifier BuildTime multiplier 0.95
    modifier BuildCost multiplier 0.95
end

technology trigonometry
    name "Trigonometry"
