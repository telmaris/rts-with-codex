    cost PAPER 200
    cost PLANKS 200
    modifier BuildCost multiplier 0.90
    modifier BuildTime multiplier 0.95
    modifier TowerRange multiplier 1.10
end

technology analytical_geometry
    name "Analytical geometry"
    description "The study of geometry through algebra and coordinates. It enabled precise modeling of space and motion."
    category SCIENCE
    layout_lane "Core Mathematics"
    tags construction logistics
    layout_order 500
    research_time 120
