    cost PAPER 300
    modifier RoadSpeed multiplier 1.2
    modifier BuildTime multiplier 0.90
end

technology differential_equations
    name "Differential equations"
    description "The study of continuous change in complex systems over time. It enabled simulation of economies, populations, and physical forces as living systems."
    category SCIENCE
    layout_lane "Core Mathematics"
    tags construction logistics
    layout_order 500
    research_time 150
    requires analytical_geometry
    cost PAPER 300
    modifier ProductionCycleTime multiplier 0.9
    modifier UnitAttackSpeed multiplier 1.1
end

technology number_theory
    name "Number theory"
    description "The study of structured properties of integers and discrete patterns. It enabled encryption, coding systems, and deterministic optimization of complex logistics."
    category SCIENCE
    layout_lane "Core Mathematics"
    tags construction logistics
    layout_order 500
    research_time 300
    requires differential_equations
    cost PAPER 500
    modifier ProductionCycleTime multiplier 0.9
    modifier UnitSiegeAttack multiplier 1.1
    modifier UnitRecruitTime multiplier 0.9
end
