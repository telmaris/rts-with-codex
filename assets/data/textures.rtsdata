# Texture bindings for every drawable slot in the game.
# Written by tools/texture-editor. Addressing: cell <texture> of <atlas>.
# An atlas is (image, cell size) - a standalone sprite is a one-cell atlas.

# atlas <id> <name> "<path>" <cellWidth> <cellHeight>
atlas 0 terrain "assets/textures/terrain/terrain_tileset.png" 32 32
atlas 1 resources "assets/textures/resources/basic_resources.png" 64 64
atlas 2 headquarters "assets/textures/building/generated/headquarters_idle/headquarters_idle_sheet_3x1.png" 96 96
atlas 3 cottage "assets/textures/building/cottage.png" 128 128
atlas 4 storage "assets/textures/building/storage.png" 96 96
atlas 5 woodcutter "assets/textures/building/woodcutter.png" 64 64
atlas 6 hunter "assets/textures/building/hunter.png" 64 64
atlas 7 lumbermill "assets/textures/building/lumbermill.png" 96 96
atlas 8 mine "assets/textures/building/mine.png" 64 64
atlas 9 foundry "assets/textures/building/foundry.png" 96 96
atlas 10 well "assets/textures/building/well.png" 64 64
atlas 11 wheat_farm "assets/textures/building/wheat_farm.png" 96 96
atlas 12 windmill "assets/textures/building/windmill.png" 128 128
atlas 13 bakery "assets/textures/building/bakery.png" 96 96
atlas 14 inn "assets/textures/building/inn.png" 96 96
atlas 15 paperworks "assets/textures/building/paperworks.png" 96 96
atlas 16 smith "assets/textures/building/smith.png" 64 64
atlas 17 university "assets/textures/building/university.png" 128 128
atlas 18 barracks "assets/textures/building/barracks.png" 96 96
atlas 19 road "assets/textures/building/road.png" 32 32
atlas 20 guard_tower "assets/textures/building/guard_tower.png" 64 64
atlas 21 tannery_idle "assets/textures/building/generated/tannery_idle/tannery_idle_sheet_2x1.png" 96 96
atlas 22 tailor_idle "assets/textures/building/generated/tailor_idle/tailor_idle_sheet_2x1.png" 96 96
atlas 23 armorer_idle "assets/textures/building/generated/armorer_idle/armorer_idle_sheet_2x1.png" 96 96

terrain GRASS
    variant atlas 0 texture 9 weight 1
    variant atlas 0 texture 10 weight 1
    variant atlas 0 texture 11 weight 1
    variant atlas 0 texture 12 weight 1
end

terrain WOOD
    variant atlas 0 texture 6 weight 1
    variant atlas 0 texture 7 weight 1
    variant atlas 0 texture 8 weight 1
end

terrain COAL
    variant atlas 0 texture 0 weight 1
    variant atlas 0 texture 1 weight 1
    variant atlas 0 texture 2 weight 1
end

terrain IRON_ORE
    variant atlas 0 texture 13 weight 1
    variant atlas 0 texture 14 weight 1
    variant atlas 0 texture 15 weight 1
end

terrain STONE
    variant atlas 0 texture 16 weight 1
    variant atlas 0 texture 17 weight 1
    variant atlas 0 texture 18 weight 1
end

terrain COPPER_ORE
    variant atlas 0 texture 0 weight 1
    variant atlas 0 texture 1 weight 1
end

terrain TIN_ORE
    variant atlas 0 texture 16 weight 1
    variant atlas 0 texture 17 weight 1
end

terrain SILVER_ORE
    variant atlas 0 texture 13 weight 1
    variant atlas 0 texture 14 weight 1
end

terrain GOLD_ORE
    variant atlas 0 texture 14 weight 1
    variant atlas 0 texture 15 weight 1
end

terrain SAND
    variant atlas 0 texture 9 weight 1
    variant atlas 0 texture 10 weight 1
end

terrain SULFUR
    variant atlas 0 texture 2 weight 1
end

terrain SALTPETER
    variant atlas 0 texture 18 weight 1
end

